# ── Production (Vercel) ───────────────────────────────────────────────────────
# Set these as Environment Variables in your Vercel project dashboard.
# Do NOT commit a .env file with real values.

# Full URL to your Render backend API (no trailing slash)
VITE_API_URL=https://your-backend.onrender.com/api

# Socket.io origin — same as your Render backend (no /api, no trailing slash)
VITE_SOCKET_URL=https://your-backend.onrender.com

# ── Local Development ─────────────────────────────────────────────────────────
# Uncomment these and comment out the production values above when developing locally.
# VITE_API_URL=http://localhost:5000/api
# VITE_DEV_API_ORIGIN=http://127.0.0.1:5000
# VITE_SOCKET_URL=http://127.0.0.1:5000
