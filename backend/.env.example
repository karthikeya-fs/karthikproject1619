PORT=5000
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/lostandfound

JWT_SECRET=your-long-random-secret-min-32-chars

# Production: set to your Vercel frontend URL (no trailing slash)
# Example: https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# App branding used in email templates
APP_NAME=Lost & Found Campus Network
# Production: set to your Render backend URL
APP_URL=https://your-backend.onrender.com

# ── SMTP Email (Gmail + App Password) ────────────────────────────────────────
# 1. Enable 2FA at https://myaccount.google.com/security
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate a 16-character App Password (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
